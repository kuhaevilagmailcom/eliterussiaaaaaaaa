BOT_TOKEN=
ADMIN_IDS=8464597898

DB_PATH=/app/data/mgn_vpn.sqlite3
DISPLAY_TZ=Asia/Yekaterinburg

# Telegram Mini App. BotHost передаёт DOMAIN/PORT после подключения домена.
MINIAPP_URL=
MINIAPP_HOST=0.0.0.0
MINIAPP_PORT=3000
MINIAPP_INITDATA_MAX_AGE=3600

# Пока серверов нет — demo. Бот не выдаёт фальшивые ссылки подключения.
VPN_MODE=demo
VPN_SERVER_NAME=MGN VPN
VPN_SUB_BASE_URL=https://vpn.example.com/sub

# H1Cloud VLESS node API
# Use VPN_MODE=h1cloud after filling these values.
# API URL is the node API endpoint and MUST include /api.
# Do not use the browser panel login/password here.
H1_API_URL=
H1_API_TOKEN=
# Optional. Leave empty if the H1Cloud API itself returns a subscription URL;
# otherwise set the node subscription template, e.g. https://HOST:PORT/sub/{uuid}
H1_SUBSCRIPTION_TEMPLATE=
# H1Cloud node installations often use a self-signed API certificate.
H1_VERIFY_SSL=false

# 3x-ui: заполнить после покупки VPS и установки панели
XUI_URL=
XUI_TOKEN=
XUI_INBOUND_IDS=
# Пример: https://sub.example.com/{sub_id}
XUI_SUBSCRIPTION_TEMPLATE=
XUI_VERIFY_SSL=true

TRIAL_MINUTES=1440
TRIAL_MAX_DEVICES=1
TRIAL_CHANNEL_USERNAME=@mgnvpnn
TRIAL_CHANNEL_URL=https://t.me/mgnvpnn

# СБП / RollyPay
ROLLYPAY_API_BASE=https://api.rollypay.io
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST_MODE=false

EMOJI_PACKS=NewsEmoji
