BOT_TOKEN=
ADMIN_IDS=

DB_PATH=/app/data/mgn_vpn.sqlite3
# Для настоящего disaster recovery смонтируйте отдельный persistent volume
# и укажите его здесь. Не используйте /app/data/backups на том же volume.
BACKUP_DIR=
DISPLAY_TZ=Asia/Yekaterinburg

# Публичные адреса production намеренно закреплены в коде:
# https://mgnvpn.ru, https://mgnvpn.ru/app и https://mgnvpn.ru/sub.
# Это не даёт прокси/хостингу случайно подменить пользовательские ссылки.
# Необязательно: Telegram file_id баннера главного меню.
MAIN_MENU_BANNER_FILE_ID=
MINIAPP_HOST=0.0.0.0
MINIAPP_PORT=3000
MINIAPP_INITDATA_MAX_AGE=3600

# Для production заполните H1_API_URL и H1_API_TOKEN.
VPN_MODE=h1cloud
VPN_SERVER_NAME=MGN VPN
# H1Cloud VLESS node API
# Use VPN_MODE=h1cloud after filling these values.
# API URL is the node API endpoint and MUST include /api.
# Do not use the browser panel login/password here.
H1_API_URL=
H1_API_TOKEN=
# Optional. Leave empty if the H1Cloud API itself returns a subscription URL;
# otherwise set the node subscription template, e.g. https://HOST:PORT/sub/{uuid}
H1_SUBSCRIPTION_TEMPLATE=
# Prefer HTTPS. Existing legacy http://*.h1cloud.net node APIs are accepted
# automatically for compatibility; arbitrary third-party HTTP endpoints still require
# the explicit development override below.
H1_VERIFY_SSL=true
H1_CA_FILE=
H1_SUBSCRIPTION_HOSTS=.h1cloud.net
# Optional Provider ID from happ-proxy.com. Enables Happ advanced renewal card/actions.
HAPP_PROVIDER_ID=
# Development/custom legacy endpoint override. Keep false unless it is really required.
ALLOW_INSECURE_H1=false
TRUSTED_PROXY_IPS=

# 3x-ui: заполнить после покупки VPS и установки панели
XUI_URL=
XUI_TOKEN=
XUI_INBOUND_IDS=
# Пример: https://sub.example.com/{sub_id}
XUI_SUBSCRIPTION_TEMPLATE=
XUI_VERIFY_SSL=true

# СБП / RollyPay
ROLLYPAY_API_BASE=https://api.rollypay.io
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_API_KEY=
ROLLYPAY_TEST_MODE=false

EMOJI_PACKS=NewsEmoji
