BOT_TOKEN=
ADMIN_IDS=

DB_PATH=mgn_vpn.sqlite3
DISPLAY_TZ=Asia/Yekaterinburg

# demo = интерфейс без реального VPN
# 3xui = нативное подключение к 3x-ui
# webhook = своя VPN-панель через HTTP API
VPN_MODE=demo
VPN_SERVER_NAME=MGN VPN

# Demo
VPN_SUB_BASE_URL=https://vpn.example.com/sub

# 3x-ui
# URL панели без завершающего /
XUI_URL=https://panel.example.com
# API token из 3x-ui. Не коммитьте настоящий токен.
XUI_TOKEN=
# ID входящих подключений, к которым добавлять клиентов
XUI_INBOUND_IDS=1
# Публичный subscription URL. {sub_id} обязателен.
# Пример: https://vpn.example.com:2096/subpath/{sub_id}
XUI_SUBSCRIPTION_TEMPLATE=https://vpn.example.com/sub/{sub_id}
XUI_VERIFY_SSL=true

# Generic webhook provider
VPN_API_URL=
VPN_API_TOKEN=

TRIAL_MINUTES=60
TRIAL_TRAFFIC_GB=10
TRIAL_MAX_DEVICES=1

# Telegram Stars
PLAN_30_PRICE=150
PLAN_90_PRICE=350
PLAN_365_PRICE=990

# Custom emoji packs
EMOJI_PACKS=CryptoGIFTPODARKI,TgAndroidIcons,progressBarEmoji
